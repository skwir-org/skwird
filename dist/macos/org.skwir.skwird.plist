<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  skwird, a user's engine for the session on macOS (docs/PLAN.md, phase
  5, step 6): a LaunchAgent of the user's own, started at their login, as
  the systemd user unit starts it on Linux (dist/systemd/skwird.service)
  and a task of the user's on Windows (dist/windows/skwird-logon.xml).

  `skwird logon add` writes it to ~/Library/LaunchAgents for the user
  running it, its program that skwird, its log in the engine's state
  folder, and has launchd take it (`launchctl bootstrap`). `skwird logon
  remove` takes it back. A package may install it the same way.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.skwir.skwird</string>
	<key>ProgramArguments</key>
	<array>
		<string>{program}</string>
		<string>serve</string>
		<!-- The engine for the session: idle never ends it, so that what it
		     hears stays live between its clients' runs. -->
		<string>--forever</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Started again where it failed, as systemd's Restart=on-failure. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<!-- A crawl yields to what the user is doing. -->
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>StandardErrorPath</key>
	<string>{log}</string>
</dict>
</plist>
