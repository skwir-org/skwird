#!/bin/sh
# skwird's package, before it is removed: the system service, where its
# administrator enabled it, stopped and disabled, so that no link is left
# to a unit gone. Not on an upgrade: postinst restarts it then.
set -e
case "$1" in
remove)
    if command -v systemctl >/dev/null 2>&1; then
        systemctl disable skwird-system.service >/dev/null 2>&1 || true
        if [ -d /run/systemd/system ]; then
            systemctl stop skwird-system.service || true
        fi
    fi
    ;;
esac
exit 0
