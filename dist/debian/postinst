#!/bin/sh
# skwird's package, configured (tools/package/deb.sh): the system
# service's user made (dist/sysusers/skwird.conf), and the service manager
# told of the new units. Nothing is enabled nor started (docs/DESIGN.md,
# decision 11): a user's engine starts with its first client, the system
# service where its administrator enables it. One enabled and running is
# restarted on the new program.
set -e
case "$1" in
configure)
    if command -v systemd-sysusers >/dev/null 2>&1; then
        systemd-sysusers skwird.conf
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl try-restart skwird-system.service || true
    fi
    ;;
esac
exit 0
