# skwird's package, before it is erased ($1 0; not on an upgrade): the
# system service, where its administrator enabled it, stopped and
# disabled, so that no link is left to a unit gone.
if [ "$1" -eq 0 ] && command -v systemctl >/dev/null 2>&1; then
    systemctl disable skwird-system.service >/dev/null 2>&1 || :
    if [ -d /run/systemd/system ]; then
        systemctl stop skwird-system.service || :
    fi
fi
exit 0
